# ==============================================================================
# ShopCast Environment Configuration Template
# Duplicate this file as '.env' and update the values with your local settings.
# DO NOT COMMIT THE REAL '.env' FILE TO VERSION CONTROL!
# ==============================================================================

# Application Environment (development | staging | production | testing)
APP_ENV=development
APP_NAME=ShopCast
DEBUG=true

# Central Logging Configuration
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE_PATH=reports/shopcast.log

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopcast_db
DB_USER=shopcast_user
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# File Paths (relative to repository root or absolute)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_EXTERNAL_DIR=data/external
MODELS_DIR=models
REPORTS_DIR=reports

# Forecasting Defaults
FORECAST_HORIZON_DAYS=30
RANDOM_SEED=42

